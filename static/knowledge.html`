<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Neuronet — Граф Знаний</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<script type="text/javascript" src="https://unpkg.com/vis-network/standalone/umd/vis-network.min.js"></script>
<style>
  :root {
    --bg: #0a0e14;
    --panel: #10151f;
    --line: #1e2733;
    --ink: #dbe4ef;
    --ink-dim: #6b7889;
    --signal: #4fd1c5;
  }
  body, html {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    background: var(--bg);
    color: var(--ink);
    font-family: 'Inter', sans-serif;
    overflow: hidden;
  }
  #header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    padding: 20px 30px;
    background: linear-gradient(to bottom, rgba(16,21,31,0.9), transparent);
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 10;
    pointer-events: none;
  }
  .title-block h1 {
    font-size: 22px;
    margin: 0;
    font-weight: 600;
  }
  .title-block .mark {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--signal);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .nav-links a {
    color: var(--ink);
    text-decoration: none;
    font-size: 14px;
    margin-left: 20px;
    pointer-events: auto;
    transition: color 0.2s;
  }
  .nav-links a:hover { color: var(--signal); }
  #graph-container {
    width: 100vw;
    height: 100vh;
    background: var(--bg);
  }
  #loading-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--bg);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 100;
    font-family: 'JetBrains Mono', monospace;
    color: var(--signal);
  }
</style>
</head>
<body>

<div id="loading-overlay">Загрузка карты знаний...</div>

<div id="header">
  <div class="title-block">
    <div class="mark">neuronet // knowledge graph</div>
    <h1>Визуализация связей данных</h1>
  </div>
  <div class="nav-links">
    <a href="/">← В чат</a>
    <a href="/admin">Админка</a>
  </div>
</div>

<div id="graph-container"></div>

<script>
  async function initGraph() {
    try {
      const response = await fetch('/api/admin/knowledge');
      const data = await response.json();
      
      document.getElementById('loading-overlay').style.display = 'none';

      const nodes = new vis.DataSet(data.nodes);
      const edges = new vis.DataSet(data.edges);

      const container = document.getElementById('graph-container');
      const options = {
        nodes: {
          shape: 'dot',
          size: 20,
          font: {
            color: '#dbe4ef',
            size: 14,
            face: 'Inter'
          },
          borderWidth: 2,
          shadow: true
        },
        edges: {
          width: 2,
          color: { color: '#1e2733', highlight: '#4fd1c5' },
          font: {
            align: 'middle',
            color: '#6b7889',
            size: 10,
            face: 'JetBrains Mono'
          },
          arrows: {
            to: { enabled: true, scaleFactor: 0.5 }
          }
        },
        physics: {
          enabled: true,
          barnesHut: {
            gravitationalConstant: -2000,
            centralGravity: 0.3,
            springLength: 150
          }
        },
        interaction: {
          hover: true,
          navigationButtons: true
        }
      };

      new vis.Network(container, { nodes, edges }, options);
    } catch (e) {
      console.error(e);
      document.getElementById('loading-overlay').textContent = 'Ошибка загрузки данных графа';
    }
  }

  initGraph();
</script>
</body>
</html>
